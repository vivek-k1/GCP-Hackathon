# Copy to `.env` and fill in values. Never commit `.env`.
# Used for policy explainer + Live Courtroom Claude fallback when Gemini fails.
ANTHROPIC_API_KEY=
VOYAGEAI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_API_KEY=
INDIAN_KANOON_API_TOKEN=

# ── Google Cloud Rapid Agent Hackathon — Live Gemini 3 + Elastic MCP ──────────
# Gemini via the google-genai SDK (AI Studio API key, or set GOOGLE_API_KEY).
GEMINI_API_KEY=
# Planning + arguments use GEMINI_FAST_MODEL by default (better free-tier quota).
GEMINI_FAST_MODEL=gemini-2.0-flash
# Pro model — used only when GEMINI_USE_PRO=1
GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_USE_PRO=1

# Kibana Agent Builder MCP server (Streamable-HTTP transport).
# MCP endpoint resolves to {KIBANA_URL}/api/agent_builder/mcp
# IMPORTANT: use the Kibana URL (*.kb.*), NOT the Elasticsearch cluster URL (*.es.*).
# Elastic Cloud example: https://my-project-c7e03f.kb.us-central1.gcp.elastic.cloud
KIBANA_URL=
# Optional: Elasticsearch cluster URL for Query DSL _search (defaults to KIBANA_URL with .kb. → .es.)
# ELASTICSEARCH_URL=https://my-project-c7e03f.es.us-central1.gcp.elastic.cloud
ELASTIC_API_KEY=
# Optional Kibana space (defaults to "default" path when unset)
KIBANA_SPACE=
# Index / index-pattern the courtroom searches for precedents & judgments
ELASTIC_INDEX=legal-judgments
# Set to 1 ONLY for local self-signed Kibana (https://localhost:5601)
ELASTIC_INSECURE_TLS=0
